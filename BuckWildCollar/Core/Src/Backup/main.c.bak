				  //"motor_adjust\r\n"
				  //"power_peripherals\r\n"
				  //"power_sleep\r\n"
				  //"sense_bno055\r\n"
				  );

		wait_until_return();

	  }
	  else if (strcmp(user_command, "active") == 0){
		  /*
		   * Activate main code
		   * State machine inside a state machine
		   * Only a reset will exit this mode.
		   */

		  if (state == init){

		  }
		  // TODO: Verify this code
		  else if(state == gps_receive){
			  while(gps.hdop < 5){
		    	  HAL_UART_Receive_IT(&hlpuart1, &rx_byte, 1);
			      char line[RX_LINE_MAX];
			      while (queue_pop(line))
			      {
			          parse_nmea(line);
			          char out[128];
			          int lat_i = (int)(gps.lat * 1000000);
			          int lon_i = (int)(gps.lon * 1000000);
			          int hdop_i = (int)(gps.hdop * 100);
			          int len = snprintf(out, sizeof(out),
			              "UTC:%s LATi:%d LONi:%d SAT:%d HDOPi:%d VALID:%d\r\n",
			              gps.utc, lat_i, lon_i, gps.sats, hdop_i, gps.valid);
			          HAL_UART_Transmit(&huart1, (uint8_t*)out, len, 100);
			      }
			      HAL_Delay(1);
			  }
		  }
		  else if(state == imu_receive){


		  }
		  else if(state == force_receive){

		  }
		  else if(state == motor_control){

		  }
		  else if (state == gps_transmit){

		  }
		  else if (state == sleep){

		  }

	  }


	  else if (strcmp(user_command, "demo_adc") == 0)
	  {
		  adc_value = Get_ADC();
		  print("Force Sensor: %d\r\n", adc_value);
		  HAL_Delay(100);

		  check_for_return();
	  }
	  else if (strcmp(user_command, "demo_bno055") == 0)
	  {
		  bno_enable();
		  // Data from BNO055 is represented as int16_t. Must be typecast.
		  // Things to watch for: Incoming byte order, data size (1 vs. 2 bytes usually)

		  if (bno_read_to_buffer(storage_buffer, 0x1A, 2) == 1){
			  imu.eul_x = (int16_t)(storage_buffer[3] << 8 | storage_buffer[2]);
		  }
		  if (bno_read_to_buffer(storage_buffer, 0x1C, 2) == 1){
			  imu.eul_y = (int16_t)(storage_buffer[3] << 8 | storage_buffer[2]);
		  }
		  if (bno_read_to_buffer(storage_buffer, 0x1E, 2) == 1){
			  imu.eul_z = (int16_t)(storage_buffer[3] << 8 | storage_buffer[2]);
		  }

		  if (bno_read_to_buffer(storage_buffer, 0x28, 2) == 1){
			  imu.lin_x = (int16_t)(storage_buffer[3] << 8 | storage_buffer[2]);
		  }
		  if (bno_read_to_buffer(storage_buffer, 0x2A, 2) == 1){
			  imu.lin_y = (int16_t)(storage_buffer[3] << 8 | storage_buffer[2]);
		  }
		  if (bno_read_to_buffer(storage_buffer, 0x2C, 2) == 1){
			  imu.lin_z = (int16_t)(storage_buffer[3] << 8 | storage_buffer[2]);
		  }

		  if (bno_read_to_buffer(storage_buffer, 0x34, 1) == 1){
			  imu.temperature = (int16_t)(storage_buffer[2]);
		  }

		  if (bno_read_to_buffer(storage_buffer, 0x2A, 2) == 1){
			  imu.mag_x = (int16_t)(storage_buffer[3] << 8 | storage_buffer[2]);
		  }
		  if (bno_read_to_buffer(storage_buffer, 0x28, 2) == 1){
			  imu.mag_y = (int16_t)(storage_buffer[3] << 8 | storage_buffer[2]);
		  }

		  if (bno_read_to_buffer(storage_buffer, 0x34, 1) == 1){
			  imu.mag_z = (int16_t)(storage_buffer[2]);
		  }

		  imu.eul_x /= 16;
		  imu.eul_y /= 16;
		  imu.eul_z /= 16;
		  imu.lin_x /=  1;
		  imu.lin_y /= 1;
		  imu.lin_z /= 1;
		  imu.temperature *= 1;

		  print("lX: %d, lY: %d, lZ: %d, eX: %d, eY: %d, eZ: %d, Temp: %d\r\n", imu.lin_y, imu.lin_x, imu.lin_z, imu.eul_x, imu.eul_y, imu.eul_z, imu.temperature);

		  check_for_return();
	  }
	  else if (strcmp(user_command, "demo_maxm10s") == 0){
    	  HAL_UART_Receive_IT(&hlpuart1, &rx_byte, 1);
	      char line[RX_LINE_MAX];

	      while (queue_pop(line))
	      {
	          parse_nmea(line);

	          char out[128];

	          int lat_i = (int)(gps.lat * 1000000);
	          int lon_i = (int)(gps.lon * 1000000);
	          int hdop_i = (int)(gps.hdop * 100);

	          int len = snprintf(out, sizeof(out),
	              "UTC:%s LATi:%d LONi:%d SAT:%d HDOPi:%d VALID:%d\r\n",
	              gps.utc, lat_i, lon_i, gps.sats, hdop_i, gps.valid);
	//          int len = snprintf(out, sizeof(out),
	//                             "UTC:%s LAT:%.6f LON:%.6f SAT:%d HDOP:%.2f VALID:%d\r\n",
	//                             gps.utc, gps.lat, gps.lon, gps.sats, gps.hdop, gps.valid);

	          HAL_UART_Transmit(&huart1, (uint8_t*)out, len, 100);
	      }

	      HAL_Delay(1);

	      check_for_return();
	  }
	  else if (strcmp(user_command, "demo_stx3") == 0){

	  }

	  else if (strcmp(user_command, "demo_motor") == 0){
		  Motor_SetDirection(MOTOR_CW);
		  Motor_SetSpeed(1);
	  }
	  else if (strcmp(user_command, "demo_motorlock") == 0){
		  Motor_SetDirection(MOTOR_CW);
		  Motor_SetSpeed(0.5);
		  Lock_SetStatus(1);

		  HAL_Delay(1000);
		  Motor_SetDirection(MOTOR_CW);
		  Motor_SetSpeed(1);
		  Lock_SetStatus(0);

		  HAL_Delay(10000);

		  if (check_for_return() == 1){
			  Motor_SetSpeed(0);
			  Lock_SetStatus(0);
		  }
	  }
	  else if (strcmp(user_command, "demo_lock") == 0){

	  }
	  else if (strcmp(user_command, "text") == 0){

	  }
	  else{
		  // Set user command to menu.
		  strcpy(user_command, "menu");
		  BSP_LED_Toggle(LED_RED);
		  print("Error: Unknown Command.\r\n");
	  }

	  // Final Modifications
  }




















    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  /* USER CODE END 3 */
}

