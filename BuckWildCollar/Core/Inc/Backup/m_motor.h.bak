#ifndef INC_M_MOTOR_H_
#define INC_M_MOTOR_H_

#include <main.h>

// This is the pinout scheme from before. We could hard-code the values but we already have this so :shrug:

#define MOTORDRIVER_AI1_PORT GPIOE
#define MOTORDRIVER_AI1_PIN GPIO_PIN_15

#define MOTORDRIVER_AI2_PORT GPIOB
#define MOTORDRIVER_AI2_PIN GPIO_PIN_0

#define MOTORDRIVER_PWMA_PORT GPIOA
#define MOTORDRIVER_PWMA_PIN GPIO_PIN_0

#define LOCK_BI1_PORT GPIOE
#define LOCK_BI1_PIN GPIO_PIN_12

#define LOCK_PWMB_PORT GPIOA
#define LOCK_PWMB_PIN GPIO_PIN_8

#define STANDBY_PORT GPIOE
#define STANDBY_PIN GPIO_PIN_0

typedef enum{
	MOTOR_STOP = 0,
	MOTOR_CCW = 1,
	MOTOR_CW = 2
} motor;

void Motor_Initialize(void);
void Motor_SetSpeed(float duty_cycle);
void Motor_SetDirection(motor direction);
void Lock_Initialize();
void Lock_SetStatus(uint8_t mode);

#endif /* INC_M_MOTOR_H_ */
